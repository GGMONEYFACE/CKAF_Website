# Supabase → Project Settings → API.
# Use the Project URL and the anon public key. Do not put the service_role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Optional. The site listens on this computer only, at http://127.0.0.1:8080.
# CKAF_HOST=127.0.0.1
# CKAF_PORT=8080
# Set this to 1 only when members open the site over HTTPS.
# CKAF_COOKIE_SECURE=1
